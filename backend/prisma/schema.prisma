generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid())
  handle              String   @unique
  email               String?  @unique
  publicAddress       String   @unique // Privy embedded owner wallet address (EOA)
  smartAccountAddress String?  @unique // Alchemy ERC-4337 smart account on Base
  authProvider        String?  // google, apple
  profilePicUrl       String?
  displayName         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sentTx              Transaction[]      @relation("Sender")
  receivedTx          Transaction[]      @relation("Receiver")
  createdGroups       Group[]            @relation("CreatedGroups")
  groupMemberships    GroupMember[]
  paidExpenses        GroupExpense[]     @relation("PaidExpenses")
  expenseSplits       GroupExpenseSplit[]
  feedbacks           Feedback[]
  settlementsPaid     GroupSettlement[]  @relation("SettlementsPaid")
  settlementsReceived GroupSettlement[]  @relation("SettlementsReceived")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User              @relation("CreatedGroups", fields: [createdById], references: [id])
  members     GroupMember[]
  expenses    GroupExpense[]
  settlements GroupSettlement[]
}

/// An audit record of one settlement action between two group members.
///
/// The unique constraints on `txHash` and `transactionId` are what make a
/// settlement single-use: the same on-chain payment can never clear a second
/// debt, with a different member or in a different group.
model GroupSettlement {
  id            String   @id @default(uuid())
  groupId       String
  payerId       String
  payeeId       String
  /// "onchain" | "internal_tx" | "manual"
  method        String
  txHash        String?  @unique
  transactionId String?  @unique
  assetSymbol   String?
  amountUsd     Decimal  @db.Decimal(24, 8)
  createdAt     DateTime @default(now())

  group  Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User                @relation("SettlementsPaid", fields: [payerId], references: [id])
  payee  User                @relation("SettlementsReceived", fields: [payeeId], references: [id])
  splits GroupExpenseSplit[]

  @@index([groupId, payerId, payeeId])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model GroupExpense {
  id          String   @id @default(uuid())
  groupId     String
  paidById    String
  description String
  amount      Decimal  @db.Decimal(24, 8)
  assetSymbol String
  createdAt   DateTime @default(now())

  group  Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User              @relation("PaidExpenses", fields: [paidById], references: [id])
  splits GroupExpenseSplit[]
}

model GroupExpenseSplit {
  id           String    @id @default(uuid())
  expenseId    String
  userId       String
  amount       Decimal   @db.Decimal(24, 8)
  settled      Boolean   @default(false)
  settledAt    DateTime?
  settlementId String?

  expense    GroupExpense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])
  settlement GroupSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@unique([expenseId, userId])
}

model Transaction {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String?
  receiverAddress String

  txHash      String   @unique
  assetSymbol String
  amount      Decimal  @db.Decimal(24, 8)
  rawAmountWei String?
  category    String?
  userNote    String?
  status      TxStatus @default(PENDING)
  createdAt   DateTime @default(now())

  sender      User     @relation("Sender", fields: [senderId], references: [id])
  receiver    User?     @relation("Receiver", fields: [receiverId], references: [id])
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  handle    String?
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
