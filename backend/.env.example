PORT=4000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
AUTH_DOMAIN=atara.finance
# Required before enabling passkeys for atara.finance in a store build.
# Apple Developer Membership details, e.g. ABCDE12345.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.atara.app
# Play Console > Test and release > App integrity > App signing certificate.
# Separate multiple SHA-256 fingerprints with commas.
ANDROID_SHA256_CERT_FINGERPRINTS=
ANDROID_PACKAGE_NAME=com.atara.app
# Legacy security data only. New authentication/MFA uses Privy.
SECURITY_ENCRYPTION_KEY=
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=feedback@atara.finance
FEEDBACK_RECIPIENT_EMAIL=feedback@atara.finance
ALCHEMY_NETWORK=base-sepolia
ALCHEMY_API_KEY=
# Comma-separated smart account types tried when verifying that a claimed
# smart account belongs to the signer. Defaults to sma-b.
SMART_ACCOUNT_TYPES=
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WIDGET_URL=https://buy-sandbox.moonpay.com/
MOONPAY_CURRENCY_CODE=usdc_base
MOONPAY_BASE_CURRENCY_CODE=eur
# Must be an HTTPS URL or Universal/App Link accepted by MoonPay; leave empty until configured.
ONRAMP_REDIRECT_URL=
VAULT_FACTORY_ADDRESS=
VAULT_RPC_URL=https://sepolia.base.org
# Keep false for the first beta. Enables the authenticated /vaults API only when explicitly released.
ENABLE_VAULTS=false
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_USDT_ADDRESS=
BASE_MAINNET_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_MAINNET_USDT_ADDRESS=
CORS_ALLOWED_ORIGINS=
# HTTPS origin of this backend, serving /api/v1/requests/pay/ links.
PUBLIC_PAYMENT_ORIGIN=
ENABLE_MAINNET_PAYMENT_REQUESTS=false
