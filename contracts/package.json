{
  "name": "atara-vault-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/compile.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "abi:check": "node scripts/compile.mjs --check",
    "deploy:sepolia": "npm run build && node --env-file-if-exists=.env scripts/deploy.mjs",
    "verify:sepolia": "node --env-file-if-exists=.env scripts/verify-deployment.mjs",
    "set:factory": "node scripts/set-factory-address.mjs"
  },
  "dependencies": { "@openzeppelin/contracts": "5.6.1" },
  "devDependencies": { "ethers": "6.17.0", "hardhat": "3.15.0", "solc": "0.8.36" }
}
